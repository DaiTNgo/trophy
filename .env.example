# ==============================================================================
# Trophy Monorepo Environment Configuration
# ==============================================================================

# Database (PostgreSQL)
POSTGRES_USER=trophy
POSTGRES_PASSWORD=trophy_secret
POSTGRES_DB=trophy
POSTGRES_PORT=5432
DATABASE_URL=postgres://trophy:trophy_secret@localhost:5432/trophy

# Ports
HTTP_PORT=80
DOCKHAND_PORT=3001

# Storage
STORAGE_DIR=./storage
# Default font files (Sans/Serif/Script) served at /fonts/*
FONTS_DIR=./fonts

# Better Auth
BETTER_AUTH_SECRET=replace-with-a-random-32-byte-secret-key
BETTER_AUTH_URL=http://localhost

# Allowed Origins (CORS)
ADMIN_APP_ORIGIN=http://localhost
STOREFRONT_APP_ORIGIN=http://localhost

# MISA Integration (Optional)
MISA_CLIENT_ID=
MISA_CLIENT_SECRET=
MISA_API_BASE_URL=https://crmconnect.misa.vn/api/v2

# JETPAY BankHub (Optional) — only domains and secrets live in env.
# Org tax number, bank code, bank account and website domain are edited by a
# super-admin in Admin → Settings → Payments.
# TEST: https://testdcauthapi.jetpay.vn and https://testdcbankhubapp.jetpay.vn/bhc
JETPAY_AUTH_URL=
JETPAY_BANKHUB_URL=
JETPAY_CLIENT_ID=
JETPAY_CLIENT_SECRET=
# "Mã Bảo Mật" from the BankHub website connection settings (webhook MD5 key)
JETPAY_WEBHOOK_KEY=

# Public Backend URL
BACKEND_PUBLIC_URL=https://api.ptplatinum.vn
