{
  "name": "trophy",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "dockhand": "docker compose -f docker-compose.dockhand.yml up -d",
    "dockhand:down": "docker compose -f docker-compose.dockhand.yml down"
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "turbo": "^2.10.12",
    "typescript": "6.0.3"
  },
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=18"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "braces": ">=3.0.4",
    "esbuild": ">=0.24.3"
  }
}