# ==============================================================================
# Trophy Monorepo Environment Configuration
# ==============================================================================

# Database (PostgreSQL)
POSTGRES_USER=trophy
POSTGRES_PASSWORD=trophy_secret
POSTGRES_DB=trophy
POSTGRES_PORT=5432
DATABASE_URL=postgres://trophy:trophy_secret@localhost:5432/trophy

# Ports
HTTP_PORT=80

# Storage
STORAGE_DIR=./storage

# Better Auth
BETTER_AUTH_SECRET=replace-with-a-random-32-byte-secret-key
BETTER_AUTH_URL=http://localhost

# Allowed Origins (CORS)
ADMIN_APP_ORIGIN=http://localhost
STOREFRONT_APP_ORIGIN=http://localhost

# MISA Integration (Optional)
MISA_CLIENT_ID=
MISA_CLIENT_SECRET=
MISA_API_BASE_URL=https://crmconnect.misa.vn/api/v2
